layout {
    cwd "/Users/matt"
    tab name="Home" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane command="/Users/matt/.nix-profile/bin/aerc" name="Mail" size="50%" {
                start_suspended false
            }
            pane size="50%" {
                pane command="/Users/matt/.nix-profile/bin/wtfutil" name="Calendar" size="18%" {
                    start_suspended false
                }
                pane command="gurk" name="Signal" size="33%" {
                    start_suspended false
                }
                pane command="/Users/matt/.nix-profile/bin/newsboat" name="News" size="48%" {
                    start_suspended false
                }
            }
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Web" focus=true hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="ddgr" focus=true {
            start_suspended false
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane cwd="/Users/matt"
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}

